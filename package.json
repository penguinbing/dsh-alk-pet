{
  "name": "dsh-alk-pet",
  "version": "0.5.0",
  "description": "Unofficial desktop pet plugin for DeepSeek Harness (DSH) with native floating windows on macOS/Windows.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penguinbing/dsh-alk-pet.git"
  },
  "homepage": "https://github.com/penguinbing/dsh-alk-pet#readme",
  "bugs": {
    "url": "https://github.com/penguinbing/dsh-alk-pet/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "native/",
    "runtime/bin/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "macos",
    "windows"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:assets": "node scripts/build-assets.mjs",
    "check:assets": "node scripts/build-assets.mjs --check",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:assets && npm run build:native"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
